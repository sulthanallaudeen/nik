# Copy this file to .env. The CRM also starts without .env in dummy mode.
AIRTEL_MODE=demo
# For live mode, obtain these values from Airtel IQ. Do not use demo credentials.
AIRTEL_USERNAME=
AIRTEL_PASSWORD=
AIRTEL_CUSTOMER_ID=
AIRTEL_CALLER_ID=
# Generate a random secret of at least 24 characters locally.
AIRTEL_WEBHOOK_SECRET=
# Account-approved callback JSON from Airtel: eventType, notifyURL, method, headers.
# Each callback must use POST and header x-crm-webhook-secret matching the secret above.
AIRTEL_CALLBACK_URLS=[]
# CRM user ID for inbound route mapping; configure before forwarding inbound events.
AIRTEL_INCOMING_AGENT_ID=

# Approved agent phone by CRM user ID; required for outgoing live calls.
AIRTEL_AGENT_NUMBERS={}

# Vonage Business Communications (VBC). Dummy is the safe default.
VBC_MODE=demo
# Live values belong on the backend only. Map CRM user IDs to their VBC user IDs.
VBC_ACCESS_TOKEN=
VBC_ACCOUNT_ID=
VBC_USER_MAP={}
VBC_WEBHOOK_SIGNING_KEY=
